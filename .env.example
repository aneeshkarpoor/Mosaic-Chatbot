# Keep this key server-side. Never place it in WordPress or browser JavaScript.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT_SECONDS=60
ALLOW_DEMO_FALLBACK=true
HOST=127.0.0.1
PORT=8000

# When the browser UI and API are deployed on different origins, set the exact
# WordPress origin, for example https://www.example.org. Do not use * in production.
ALLOWED_ORIGIN=

# Optional override for an updated, approved Mosaic CSV.
MOSAIC_KB_PATH=data/mosaic_resources.csv
