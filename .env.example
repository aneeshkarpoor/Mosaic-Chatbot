# Keep this key server-side. Never place it in WordPress or browser JavaScript.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT_SECONDS=120
ALLOW_DEMO_FALLBACK=true
HOST=127.0.0.1
PORT=8000

# Supabase PostgreSQL connection string. Keep this server-side and include
# sslmode=require when it is not already present in the supplied URL.
DATABASE_URL=

# When the browser UI and API are deployed on different origins, set the exact
# WordPress origin, for example https://www.example.org. Do not use * in production.
ALLOWED_ORIGIN=

# Local fallback used when Supabase is not configured or cannot be reached.
MOSAIC_KB_PATH=data/mosaic_resources.csv
